      },
      "title": "Unresolved",
      "type": "object"
    },
    "modes": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Modes",
      "type": "object"
    },
    "matrices": {
      "additionalProperties": true,
      "title": "Matrices",
      "type": "object"
    },
    "route_shapes": {
      "additionalProperties": true,
      "title": "Route Shapes",
      "type": "object"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
