{
  "$defs": {
    "GeoLocation": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        },
        "quality": {
          "enum": [
            "building_match",
            "manual",
            "approximate"
          ],
          "title": "Quality",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "query": {
          "default": "",
          "title": "Query",
          "type": "string"
        },
        "osm_id": {
          "default": "",
          "title": "Osm Id",
          "type": "string"
        },
        "original_address": {
          "default": "",
          "title": "Original Address",
          "type": "string"
        },
        "approximation_reason": {
          "default": "",
          "title": "Approximation Reason",
          "type": "string"
        }
      },
      "required": [
        "lat",
        "lon",
        "quality",
        "source"
      ],
      "title": "GeoLocation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scenario_signature": {
      "title": "Scenario Signature",
      "type": "string"
    },
    "locations": {
