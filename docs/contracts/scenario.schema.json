      "required": [
        "x_km",
        "y_km"
      ],
      "title": "Point",
      "type": "object"
    },
    "Request": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "region": {
          "minLength": 1,
          "title": "Region",
          "type": "string"
        },
        "address": {
          "minLength": 1,
          "title": "Address",
          "type": "string"
        },
        "locality": {
          "default": "",
          "title": "Locality",
          "type": "string"
        },
        "date": {
          "title": "Date",
          "type": "string"
        },
        "bk_type": {
          "default": "",
          "title": "Bk Type",
          "type": "string"
