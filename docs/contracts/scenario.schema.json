          "exclusiveMinimum": 0,
          "maximum": 1440,
          "title": "Duration Minutes",
          "type": "integer"
        },
        "skill": {
          "$ref": "#/$defs/Skill"
        },
        "required_transport": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transport"
            },
