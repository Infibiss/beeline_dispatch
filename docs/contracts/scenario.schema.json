{
  "$defs": {
    "Engineer": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "region": {
          "title": "Region",
          "type": "string"
        },
        "start_location": {
          "default": "office",
          "title": "Start Location",
          "type": "string"
        },
        "start_address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Address"
        },
        "shift": {
          "$ref": "#/$defs/TimeWindow"
        },
        "skills": {
          "items": {
            "$ref": "#/$defs/Skill"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Skills",
          "type": "array"
        },
        "transport": {
          "$ref": "#/$defs/Transport"
        },
        "vehicle_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vehicle Id"
        },
        "stock": {
          "anyOf": [
            {
              "$ref": "#/$defs/Equipment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "name",
        "region",
        "shift",
        "skills",
        "transport"
      ],
      "title": "Engineer",
      "type": "object"
    },
    "Equipment": {
      "additionalProperties": false,
      "properties": {
        "router": {
          "default": 0,
          "minimum": 0,
          "title": "Router",
          "type": "integer"
        },
        "tv_box": {
          "default": 0,
          "minimum": 0,
          "title": "Tv Box",
          "type": "integer"
        }
      },
      "title": "Equipment",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "x_km": {
          "title": "X Km",
          "type": "number"
        },
        "y_km": {
          "title": "Y Km",
          "type": "number"
        }
      },
      "required": [
        "x_km",
        "y_km"
      ],
      "title": "Point",
      "type": "object"
    },
    "Request": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "region": {
          "minLength": 1,
          "title": "Region",
          "type": "string"
        },
        "address": {
          "minLength": 1,
          "title": "Address",
          "type": "string"
        },
        "locality": {
          "default": "",
          "title": "Locality",
          "type": "string"
        },
        "date": {
          "title": "Date",
          "type": "string"
        },
        "bk_type": {
          "default": "",
          "title": "Bk Type",
          "type": "string"
        },
        "hd_type": {
          "default": "",
          "title": "Hd Type",
          "type": "string"
        },
        "windows": {
          "items": {
            "$ref": "#/$defs/TimeWindow"
          },
          "minItems": 1,
          "title": "Windows",
          "type": "array"
        },
        "duration_minutes": {
          "exclusiveMinimum": 0,
          "maximum": 1440,
          "title": "Duration Minutes",
          "type": "integer"
        },
        "skill": {
          "$ref": "#/$defs/Skill"
        },
        "required_transport": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "priority": {
          "default": "normal",
          "enum": [
            "normal",
            "high",
            "urgent"
          ],
          "title": "Priority",
          "type": "string"
        },
        "equipment": {
          "$ref": "#/$defs/Equipment"
        },
        "source_line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Line"
        },
        "provenance": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Provenance",
          "type": "object"
        }
      },
      "required": [
        "id",
        "region",
        "address",
        "date",
        "windows",
        "duration_minutes",
        "skill"
      ],
      "title": "Request",
      "type": "object"
    },
    "Skill": {
      "enum": [
        "local",
        "connection",
        "emergency"
      ],
      "title": "Skill",
      "type": "string"
    },
    "TimeWindow": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "maximum": 1440,
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "maximum": 1440,
          "minimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    },
    "Transport": {
      "enum": [
        "car",
        "walk",
        "bicycle",
        "public"
      ],
      "title": "Transport",
      "type": "string"
    },
    "Vehicle": {
      "additionalProperties": false,
      "description": "Optional physical vehicle data used by the transparent fleet risk score.",
      "properties": {
        "id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "default": "car",
          "enum": [
            "car",
            "van",
            "special"
          ],
          "title": "Kind",
          "type": "string"
        },
        "odometer_km": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Odometer Km"
        },
        "odometer_observed_on": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Odometer Observed On"
        },
        "next_service_km": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Service Km"
        },
        "next_service_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Service Date"
        },
        "open_defects": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Open Defects",
          "type": "integer"
        },
        "maintenance": {
          "items": {
            "$ref": "#/$defs/VehicleMaintenance"
          },
          "maxItems": 500,
          "title": "Maintenance",
          "type": "array"
        },
        "failures": {
          "items": {
            "$ref": "#/$defs/VehicleFailure"
          },
          "maxItems": 500,
          "title": "Failures",
          "type": "array"
        },
        "active": {
          "default": true,
          "title": "Active",
          "type": "boolean"
        },
        "source": {
          "default": "provided",
          "enum": [
            "provided",
            "synthetic_demo",
            "unknown"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "Vehicle",
      "type": "object"
    },
    "VehicleFailure": {
      "additionalProperties": false,
      "description": "A factual fleet incident. It is evidence, not a calibrated probability.",
      "properties": {
        "occurred_on": {
          "title": "Occurred On",
          "type": "string"
        },
        "kind": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "severity": {
          "default": "minor",
          "enum": [
            "minor",
            "major",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "odometer_km": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Odometer Km"
        },
        "downtime_hours": {
          "default": 0,
          "maximum": 8760,
          "minimum": 0,
          "title": "Downtime Hours",
          "type": "number"
        },
        "resolved": {
          "default": true,
          "title": "Resolved",
          "type": "boolean"
        }
      },
      "required": [
        "occurred_on",
        "kind"
      ],
      "title": "VehicleFailure",
      "type": "object"
    },
    "VehicleMaintenance": {
      "additionalProperties": false,
      "description": "A completed maintenance action used to audit the fleet data lineage.",
      "properties": {
        "performed_on": {
          "title": "Performed On",
          "type": "string"
        },
        "odometer_km": {
          "minimum": 0,
          "title": "Odometer Km",
          "type": "integer"
        },
        "kind": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "note": {
          "default": "",
          "maxLength": 500,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "performed_on",
        "odometer_km",
        "kind"
      ],
      "title": "VehicleMaintenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "region": {
      "title": "Region",
      "type": "string"
    },
    "date": {
      "title": "Date",
      "type": "string"
    },
    "office_address": {
      "title": "Office Address",
      "type": "string"
    },
    "requests": {
      "items": {
        "$ref": "#/$defs/Request"
      },
      "title": "Requests",
      "type": "array"
    },
    "engineers": {
      "items": {
        "$ref": "#/$defs/Engineer"
      },
      "minItems": 1,
      "title": "Engineers",
      "type": "array"
    },
    "vehicles": {
      "items": {
        "$ref": "#/$defs/Vehicle"
      },
      "title": "Vehicles",
      "type": "array"
    },
    "points": {
      "additionalProperties": {
        "$ref": "#/$defs/Point"
      },
      "title": "Points",
      "type": "object"
    },
    "travel_config": {
      "additionalProperties": true,
      "title": "Travel Config",
      "type": "object"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "id",
    "region",
    "date",
    "office_address",
    "requests",
    "engineers"
  ],
  "title": "Scenario",
  "type": "object"
}
