          "minItems": 1,
          "title": "Skills",
          "type": "array"
        },
        "transport": {
          "$ref": "#/$defs/Transport"
        },
        "stock": {
          "anyOf": [
            {
              "$ref": "#/$defs/Equipment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "name",
        "region",
        "shift",
        "skills",
        "transport"
      ],
      "title": "Engineer",
      "type": "object"
    },
    "Equipment": {
      "additionalProperties": false,
      "properties": {
        "router": {
          "default": 0,
