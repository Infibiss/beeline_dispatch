{
  "$defs": {
    "Engineer": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "region": {
          "title": "Region",
          "type": "string"
        },
        "start_location": {
          "default": "office",
          "title": "Start Location",
          "type": "string"
        },
        "start_address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Address"
        },
        "shift": {
          "$ref": "#/$defs/TimeWindow"
        },
        "skills": {
          "items": {
            "$ref": "#/$defs/Skill"
          },
